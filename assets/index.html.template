<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>__TITLE__</title>
<style>
  :root {
    --bg: #f7f8fa; --panel: #ffffff; --panel2: #f1f3f6; --border: #e4e7ec;
    --text: #0b0d10; --muted: #6b7280; --accent: #d97706; --accent2: #f59e0b;
    --green: #16a34a; --red: #dc2626;
    --shadow: 0 1px 2px rgba(15,23,42,0.04), 0 1px 3px rgba(15,23,42,0.06);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text);
    font-family: ui-sans-serif, -apple-system, "SF Pro Text", system-ui, sans-serif; }
  body { padding: 32px 24px 80px; max-width: min(1180px, calc(100vw - 324px)); margin: 0; }
  header.top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; flex-wrap: wrap; gap: 12px; }
  h1 { margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
  .meta { color: var(--muted); font-size: 12px; margin-top: 6px; }

  /* ========== YOUR ARTIFACT CONTENT GOES IN #content ========== */
  /* Every element you want commentable should have data-node-id="<id>". */
  /* Elements without data-node-id become "freeform" pins with auto-detected anchor. */
  #content section { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 22px; margin-bottom: 18px; box-shadow: var(--shadow); }

  /* Redacted helper (optional — for blurring sensitive fields) */
  .redacted { display: inline-block; filter: blur(5px); user-select: none; background: #d8dbe2; padding: 2px 8px; border-radius: 4px; color: #888; font-variant-numeric: tabular-nums; }

  /* Pin mode toggle */
  .pin-toggle { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 8px 14px; font: inherit; font-size: 12px; font-weight: 600; color: var(--text); cursor: pointer; box-shadow: var(--shadow); display: inline-flex; align-items: center; gap: 6px; }
  .pin-toggle:hover { border-color: var(--accent); }
  .pin-toggle.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .pin-toggle::before { content: "📍"; font-size: 14px; }
  body.pin-mode { cursor: crosshair; }
  body.pin-mode [data-node-id] { cursor: crosshair !important; }

  /* Floating pin overlay */
  #pin-overlay { position: absolute; top: 0; left: 0; width: 100%; pointer-events: none; z-index: 50; }
  .floating-pin { position: absolute; pointer-events: auto; transform: translate(-50%, -100%); cursor: pointer; }
  .floating-pin .marker { width: 26px; height: 32px; display: flex; align-items: flex-start; justify-content: center; padding-top: 4px; color: #fff; font-size: 11px; font-weight: 700; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25)); }
  .floating-pin .marker svg { position: absolute; top: 0; left: 0; width: 26px; height: 32px; }
  .floating-pin.pending svg path { fill: #f59e0b; }
  .floating-pin.addressed svg path { fill: #16a34a; }
  .floating-pin.saved svg path { fill: #64748b; }
  .floating-pin .marker span { position: relative; z-index: 1; line-height: 1; margin-top: 4px; }
  .floating-pin:hover { transform: translate(-50%, -100%) scale(1.1); }
  .floating-pin.active svg path { stroke: var(--text); stroke-width: 1.5; }
  .floating-pin .delete-btn { position: absolute; top: -10px; right: -14px; width: 22px; height: 22px; border-radius: 50%; background: var(--red); color: #fff; border: 2px solid #fff; font-size: 13px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; font-weight: 700; opacity: 0; transition: opacity 100ms; box-shadow: 0 2px 6px rgba(0,0,0,0.25); z-index: 2; }
  .floating-pin:hover .delete-btn, .floating-pin.active .delete-btn { opacity: 1; }
  .floating-pin .delete-btn:hover { transform: scale(1.15); }

  /* Anchored pin badge (on elements with data-node-id that have comments) */
  [data-node-id] { position: relative; }
  .anchor-pin { position: absolute; top: 4px; right: 4px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: var(--accent2); color: #fff; font-size: 10px; font-weight: 700; display: none; align-items: center; justify-content: center; box-shadow: var(--shadow); z-index: 2; }
  .anchor-pin.show { display: inline-flex; }
  .anchor-pin.addressed { background: var(--green); }
  .anchor-pin.saved { background: #64748b; }

  /* Comment panel — opens next to click */
  #panel { position: absolute; width: 380px; max-height: 60vh; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; box-shadow: 0 20px 50px rgba(15,23,42,0.18); display: none; flex-direction: column; overflow: hidden; z-index: 70; }
  #panel.open { display: flex; }
  #panel header { padding: 14px 16px; background: var(--panel2); border-bottom: 1px solid var(--border); display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
  #panel header .title { font-size: 14px; font-weight: 700; }
  #panel header .sub { font-size: 11px; color: var(--muted); margin-top: 2px; font-family: ui-monospace, "SF Mono", monospace; }
  #panel header button { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 22px; line-height: 1; padding: 0 4px; }
  #panel .body { padding: 14px 16px; overflow-y: auto; flex: 1; }
  #panel textarea { width: 100%; min-height: 80px; background: var(--panel2); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; color: var(--text); font: inherit; font-size: 13px; resize: vertical; }
  #panel textarea:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: var(--accent); }
  #panel button.submit { margin-top: 8px; background: var(--accent); color: #fff; border: none; padding: 9px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 13px; }
  #panel button.submit:hover { background: #b45309; }
  #panel button.submit:disabled { opacity: 0.5; cursor: not-allowed; }
  .submit-row { display: flex; gap: 8px; }
  #panel button.submit.secondary { background: var(--panel2); color: var(--text); border: 1px solid var(--border); }
  #panel button.submit.secondary:hover { background: #e7ebf0; border-color: #64748b; }
  #submit-draft { width: 100%; }
  .comments-list { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
  .comment { background: var(--panel2); border: 1px solid var(--border); border-radius: 10px; padding: 11px 13px; }
  .comment .head { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--muted); margin-bottom: 6px; }
  .comment .status { padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .comment .status.pending { background: rgba(245, 158, 11, 0.15); color: #b45309; }
  .comment .status.addressed { background: rgba(22, 163, 74, 0.15); color: var(--green); }
  .comment .status.saved { background: rgba(100,116,139,0.15); color: #475569; }
  .comment .status.gone { background: rgba(124,58,237,0.15); color: #6d28d9; }
  .comment .text { font-size: 13px; color: var(--text); white-space: pre-wrap; }
  .comment .response { margin-top: 8px; padding: 8px 10px; background: #fff; border-left: 3px solid var(--green); border-radius: 4px; font-size: 12px; color: var(--text); white-space: pre-wrap; }
  .comment .response::before { content: "Claude · "; color: var(--green); font-weight: 700; }
  .comment .delete { background: transparent; border: 1px solid var(--border); border-radius: 6px; color: var(--muted); cursor: pointer; font-size: 14px; padding: 2px 8px; line-height: 1; min-width: 24px; min-height: 24px; }
  .comment .delete:hover { color: #fff; background: var(--red); border-color: var(--red); }

  .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: var(--text); color: #fff; padding: 10px 18px; border-radius: 8px; font-size: 13px; font-weight: 500; opacity: 0; transition: opacity 200ms; z-index: 100; }
  .toast.show { opacity: 1; }

  /* ---- Example artifact content (replace with your own) ---- */
  #content section h2 { margin: 0 0 8px; font-size: 16px; font-weight: 700; }
  #content section p { margin: 0; font-size: 13px; line-height: 1.55; color: var(--text); }

  /* Markdown-rendered Claude response (overrides pre-wrap above) */
  .comment .response { white-space: normal; }
  .comment .response p { margin: 0 0 6px; }
  .comment .response p:last-child { margin-bottom: 0; }
  .comment .response ul, .comment .response ol { margin: 4px 0; padding-left: 18px; }
  .comment .response li { margin: 2px 0; }
  .comment .response code { background: var(--panel2); padding: 1px 5px; border-radius: 4px; font-family: ui-monospace, "SF Mono", monospace; font-size: 11px; }
  .comment .response pre { background: var(--panel2); padding: 8px 10px; border-radius: 6px; overflow-x: auto; margin: 6px 0; }
  .comment .response pre code { background: none; padding: 0; }
  .comment .response a { color: var(--accent); }
  .comment .response strong { font-weight: 700; }

  /* ---- Pin sidebar ---- */
  #pin-sidebar { position: fixed; top: 0; right: 0; bottom: 0; width: 300px; background: var(--panel); border-left: 1px solid var(--border); display: flex; flex-direction: column; z-index: 60; box-shadow: -2px 0 12px rgba(15,23,42,0.05); }
  #pin-sidebar .sb-head { padding: 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  #pin-sidebar .sb-head h2 { margin: 0; font-size: 14px; font-weight: 700; }
  #pin-sidebar .dl-btn { background: var(--panel2); border: 1px solid var(--border); border-radius: 7px; padding: 6px 10px; font: inherit; font-size: 11px; font-weight: 600; color: var(--text); cursor: pointer; white-space: nowrap; }
  #pin-sidebar .dl-btn:hover { border-color: var(--accent); color: var(--accent); }
  .sb-actions { padding: 0 16px 12px; border-bottom: 1px solid var(--border); }
  #submit-all { width: 100%; background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 9px 12px; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
  #submit-all:hover { background: #b45309; }
  #submit-all:disabled { background: var(--panel2); color: var(--muted); cursor: not-allowed; }
  #pin-list { overflow-y: auto; flex: 1; padding: 8px; display: flex; flex-direction: column; gap: 6px; }
  .sb-empty { font-size: 12px; color: var(--muted); padding: 22px 14px; text-align: center; line-height: 1.55; }
  .pin-item { display: flex; align-items: flex-start; gap: 9px; width: 100%; text-align: left; background: var(--panel2); border: 1px solid var(--border); border-radius: 9px; padding: 10px 11px; cursor: pointer; font: inherit; }
  .pin-item:hover { border-color: var(--accent); }
  .pin-item.active { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(217,119,6,0.15); }
  .pin-item .pi-num { width: 20px; height: 20px; border-radius: 50%; margin-top: 1px; flex: none; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #fff; }
  .pin-item.pending .pi-num { background: var(--accent2); }
  .pin-item.addressed .pi-num { background: var(--green); }
  .pin-item.saved .pi-num { background: #64748b; }
  .pin-item.gone .pi-num { background: #7c3aed; }
  .pin-item.gone { border-style: dashed; opacity: 0.9; }
  .pi-gone { color: #6d28d9; font-weight: 700; }
  .pi-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .pi-text { font-size: 12.5px; color: var(--text); line-height: 1.35; }
  .pi-meta { font-size: 10.5px; color: var(--muted); }
  .pi-count { font-weight: 700; color: var(--text); }

  /* ---- Area-selection highlight boxes (drawn in #pin-overlay, page coords) ---- */
  .pin-hl { position: absolute; pointer-events: none; border-radius: 2px; }
  .pin-hl.pending { background: rgba(245,158,11,0.22); box-shadow: 0 0 0 1px rgba(245,158,11,0.45); }
  .pin-hl.addressed { background: rgba(22,163,74,0.18); box-shadow: 0 0 0 1px rgba(22,163,74,0.4); }
  .pin-hl.saved { background: rgba(100,116,139,0.18); box-shadow: 0 0 0 1px rgba(100,116,139,0.4); }

  /* ---- Region (drag-rectangle) pins ---- */
  .pin-region { position: absolute; pointer-events: none; border-radius: 3px; }
  .pin-region.pending { background: rgba(245,158,11,0.12); box-shadow: 0 0 0 2px rgba(245,158,11,0.55); }
  .pin-region.addressed { background: rgba(22,163,74,0.10); box-shadow: 0 0 0 2px rgba(22,163,74,0.5); }
  .pin-region.saved { background: rgba(100,116,139,0.10); box-shadow: 0 0 0 2px rgba(100,116,139,0.5); }
  #rubber { position: absolute; pointer-events: none; z-index: 75; border: 2px dashed var(--accent); background: rgba(217,119,6,0.08); border-radius: 3px; display: none; }

  /* ---- Chat panel (Claude <-> user, not tied to a pin) ---- */
  #chat-dock { position: fixed; left: 18px; bottom: 18px; width: 340px; z-index: 80; }
  #chat-dock .chat-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: var(--text); color: #fff; border-radius: 12px; padding: 10px 14px; cursor: pointer; box-shadow: 0 8px 24px rgba(15,23,42,0.18); user-select: none; }
  #chat-dock .ch-title { font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 8px; }
  #chat-dock .ch-title::before { content: "💬"; }
  #chat-dock .chat-unread { background: var(--accent); color: #fff; border-radius: 999px; min-width: 18px; height: 18px; padding: 0 5px; font-size: 11px; font-weight: 700; display: none; align-items: center; justify-content: center; }
  #chat-dock .chat-unread.show { display: inline-flex; }
  #chat-dock .chat-toggle { font-size: 12px; opacity: 0.85; }
  #chat-dock .chat-body { display: none; flex-direction: column; background: var(--panel); border: 1px solid var(--border); border-top: none; border-radius: 0 0 12px 12px; box-shadow: 0 18px 40px rgba(15,23,42,0.18); overflow: hidden; }
  #chat-dock.open .chat-body { display: flex; }
  #chat-dock.open .chat-head { border-radius: 12px 12px 0 0; }
  #chat-messages { max-height: 46vh; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .chat-empty { color: var(--muted); font-size: 12px; text-align: center; padding: 18px 10px; line-height: 1.5; }
  .chat-msg { max-width: 85%; padding: 8px 11px; border-radius: 12px; font-size: 12.5px; line-height: 1.45; }
  .chat-msg.user { align-self: flex-end; background: var(--accent); color: #fff; border-bottom-right-radius: 4px; white-space: pre-wrap; }
  .chat-msg.claude { align-self: flex-start; background: var(--panel2); color: var(--text); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
  .chat-msg.claude p { margin: 0 0 6px; } .chat-msg.claude p:last-child { margin-bottom: 0; }
  .chat-msg.claude ul, .chat-msg.claude ol { margin: 4px 0; padding-left: 18px; }
  .chat-msg.claude code { background: #fff; padding: 1px 5px; border-radius: 4px; font-family: ui-monospace, "SF Mono", monospace; font-size: 11px; }
  .chat-msg.claude pre { background: #fff; padding: 8px 10px; border-radius: 6px; overflow-x: auto; margin: 6px 0; }
  .chat-msg.claude pre code { background: none; padding: 0; }
  .chat-msg.claude a { color: var(--accent); }
  #chat-input-row { display: flex; gap: 8px; padding: 10px; border-top: 1px solid var(--border); background: var(--panel2); }
  #chat-input { flex: 1; resize: none; min-height: 38px; max-height: 120px; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font: inherit; font-size: 12.5px; color: var(--text); }
  #chat-input:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: var(--accent); }
  #chat-send { background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 0 14px; font-weight: 600; cursor: pointer; font-size: 12.5px; }
  #chat-send:hover { background: #b45309; }
  #chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
  @keyframes chat-bump { 0%,100% { transform: translateY(0); } 30% { transform: translateY(-4px); } }
  #chat-dock.bump .chat-head { animation: chat-bump 0.4s ease; }
</style>
</head>
<body>

<header class="top">
  <div>
    <h1>__TITLE__</h1>
    <div class="meta" id="meta">Loading…</div>
  </div>
  <div style="display:flex;gap:12px;align-items:center;">
    <button class="pin-toggle" id="pin-toggle">Pin mode: off</button>
    <button id="shutdown-btn" title="Stop the server and close the channel" style="background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:8px 14px;font:inherit;font-size:12px;font-weight:600;color:var(--text);cursor:pointer;box-shadow:var(--shadow);">Done / Shut down</button>
  </div>
</header>

<div id="pin-overlay"></div>

<!-- Painted by window.renderArtifact(DATA) from data.json. Each section / sub-card /
     open-item carries data-node-id so it's commentable; clicks on whitespace become
     freeform pins anchored to the nearest data-node-id. -->
<main id="content"></main>

<aside id="panel">
  <header>
    <div>
      <div class="title" id="panel-title">—</div>
      <div class="sub" id="panel-sub">—</div>
    </div>
    <button id="panel-close">×</button>
  </header>
  <div class="body">
    <textarea id="comment-text" placeholder="Leave a pinned comment. It pushes to Claude over the channel instantly — Claude runs whatever queries it needs and updates the artifact in place. Your comment stays pinned with a status."></textarea>
    <div class="submit-row">
      <button class="submit" id="comment-save">Save pin</button>
      <button class="submit secondary" id="comment-submit">Submit to Claude</button>
    </div>
    <button class="submit submit-draft" id="submit-draft" style="display:none;">Submit this pin to Claude</button>
    <div class="comments-list" id="comments-list"></div>
  </div>
</aside>

<aside id="pin-sidebar">
  <div class="sb-head">
    <h2>Pins · <span id="sb-count">0</span></h2>
    <button class="dl-btn" id="dl-json" title="Download all comments as JSON">Download JSON</button>
  </div>
  <div class="sb-actions">
    <button id="submit-all" disabled>Submit all (0)</button>
  </div>
  <div id="pin-list"></div>
</aside>

<aside id="chat-dock">
  <div class="chat-head" id="chat-head">
    <span class="ch-title">Chat with Claude <span class="chat-unread" id="chat-unread">0</span></span>
    <span class="chat-toggle" id="chat-toggle">▴</span>
  </div>
  <div class="chat-body">
    <div id="chat-messages"></div>
    <div id="chat-input-row">
      <textarea id="chat-input" placeholder="Message Claude… (not tied to a pin)"></textarea>
      <button id="chat-send">Send</button>
    </div>
  </div>
</aside>

<div class="toast" id="toast">Comment pinned.</div>

<script>
let DATA = null;
let COMMENTS = [];
let activePin = null;     // { id, nodeId, nodeLabel, anchorNodeId } when a pin thread is open
let pendingPin = null;    // { x, y, anchorNodeId, contextSnippet, label } for a new pin
let pinMode = false;
let CHAT = [];
let chatOpen = false;
let chatSeen = 0; // count of Claude messages the user has already seen

// ---- Artifact renderer: paints DATA (data.json) into #content. ----
// REPLACE THIS with whatever your artifact should show. The only contract:
// every element a user can comment on needs data-node-id="<id>", where <id>
// matches an object's "id" in data.json (so update_node can patch it). Clicks
// on whitespace / un-tagged elements become freeform pins anchored to the
// nearest data-node-id. See references/architecture.md for the data-shape menu.
function renderArtifactInner(DATA) {
  const root = document.getElementById("content");
  const nodes = Array.isArray(DATA.nodes) ? DATA.nodes : [];
  if (!nodes.length) {
    root.innerHTML =
      `<section><h2>${escapeHtml(DATA.title || "Interactive artifact")}</h2>` +
      `<p>Put your data in <code>data.json</code> (starter shape: a <code>nodes</code> ` +
      `array of <code>{ id, label, body }</code>) and edit <code>renderArtifactInner()</code> ` +
      `to paint it. Toggle Pin mode, then click or select text to leave a comment that ` +
      `routes to Claude.</p></section>`;
    return;
  }
  root.innerHTML = nodes.map((n) => `
    <section data-node-id="${escapeHtml(String(n.id))}">
      <h2>${escapeHtml(n.label || String(n.id))}</h2>
      ${n.body ? `<p>${escapeHtml(n.body)}</p>` : ""}
    </section>`).join("");
}

// Wrap so a render bug degrades to a visible error instead of a blank page.
window.renderArtifact = function (DATA) {
  try {
    renderArtifactInner(DATA);
  } catch (err) {
    document.getElementById("content").innerHTML =
      `<section style="border-color:var(--red)"><h3 style="color:var(--red);margin:0 0 6px">Render error</h3>` +
      `<div style="font-size:12px;white-space:pre-wrap">${escapeHtml(String((err && err.stack) || err))}</div></section>`;
    console.error("renderArtifact failed:", err);
  }
};

// Minimal, dependency-free markdown → safe HTML. Block-first (split blocks →
// classify list / code / paragraph), then inline. Every text run is escaped
// before any tag is added, so nothing in a Claude reply can inject markup.
function renderMarkdown(src) {
  const text = String(src == null ? "" : src);
  // Protect fenced code blocks so their contents aren't treated as markdown.
  const code = [];
  const work = text.replace(/```([\s\S]*?)```/g, (_, c) => {
    code.push(`<pre><code>${escapeHtml(c.replace(/^\n/, "").replace(/\n$/, ""))}</code></pre>`);
    return `␀C${code.length - 1}␀`;
  });

  const inline = (str) => {
    let s = escapeHtml(str);
    s = s.replace(/`([^`\n]+)`/g, "<code>$1</code>");
    s = s.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>").replace(/__([^_]+)__/g, "<strong>$1</strong>");
    s = s.replace(/(^|[^*])\*([^*\n]+)\*/g, "$1<em>$2</em>").replace(/(^|[^_])_([^_\n]+)_/g, "$1<em>$2</em>");
    s = s.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
    return s;
  };

  return work.split(/\n{2,}/).map((block) => {
    const out = [];
    let para = [];
    let list = [];
    const flushPara = () => { if (para.length) { out.push(`<p>${para.map(inline).join("<br>")}</p>`); para = []; } };
    const flushList = () => { if (list.length) { out.push(`<ul>${list.map((li) => `<li>${inline(li)}</li>`).join("")}</ul>`); list = []; } };
    for (const line of block.split("\n")) {
      const bullet = line.match(/^\s*[-*]\s+(.*)$/);
      const codeTok = line.match(/^␀C(\d+)␀$/);
      if (codeTok) { flushPara(); flushList(); out.push(code[Number(codeTok[1])]); }
      else if (bullet) { flushPara(); list.push(bullet[1]); }
      else if (line.trim() === "") { /* skip stray blank */ }
      else { flushList(); para.push(line); }
    }
    flushPara(); flushList();
    return out.join("");
  }).join("");
}

async function load() {
  const [d, c] = await Promise.all([
    fetch("/data.json", { cache: "no-store" }).then((r) => r.json()),
    fetch("/comments.json", { cache: "no-store" }).then((r) => r.json()),
  ]);
  DATA = d;
  COMMENTS = c.comments;
  render();
}

function render() {
  document.getElementById("meta").textContent =
    DATA.source ? `Source: ${DATA.source}` : "";

  // Hook: call your custom render here to paint the content into #content.
  // The plumbing below works for any DOM that has [data-node-id] elements.
  if (typeof window.renderArtifact === "function") {
    window.renderArtifact(DATA);
  }

  resolvePins();
  renderSidebar();
  renderFloatingPins();
  refreshOpenThread();
}

// Root pins = comments that aren't follow-ups, newest first.
function rootPins() {
  return COMMENTS
    .filter((c) => !c.parentId)
    .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
}

function threadStatus(rootId) {
  const root = COMMENTS.find((c) => c.id === rootId);
  if (root && root.status === "saved") return "saved";
  const t = threadFor(rootId);
  return t.length && t.every((c) => c.status === "addressed") ? "addressed" : "pending";
}

// Status used for SIDEBAR display/colour: "gone" overrides everything when the
// pin's anchor can't be resolved; otherwise the normal thread status.
function displayStatus(rootId) {
  const r = RESOLVED.get(rootId);
  if (r && r.gone) return "gone";
  return threadStatus(rootId);
}

// Friendly label for a node id, shown in the sidebar. Defaults to the matching
// node's label (or the id). Customise to map ids to nicer names for your domain.
function nodeTitle(nodeId) {
  if (!nodeId || nodeId === "freeform") return "Freeform";
  const nodes = (DATA && Array.isArray(DATA.nodes)) ? DATA.nodes : [];
  const n = nodes.find((x) => String(x.id) === nodeId);
  return n ? (n.label || String(n.id)) : nodeId;
}

// Stable display number = position among ON-PAGE (resolved, not gone) markers in
// creation order, so a sidebar number matches the teardrop on the page.
function pinNumbers() {
  const m = new Map();
  let i = 0;
  COMMENTS.forEach((c) => {
    if (c.parentId) return;
    const r = RESOLVED.get(c.id);
    if (r && !r.gone) m.set(c.id, ++i);
  });
  return m;
}

function renderSidebar() {
  const list = document.getElementById("pin-list");
  const roots = rootPins();
  const nums = pinNumbers();
  document.getElementById("sb-count").textContent = String(roots.length);
  const savedCount = COMMENTS.filter((c) => c.status === "saved").length;
  const submitAllBtn = document.getElementById("submit-all");
  submitAllBtn.textContent = `Submit all (${savedCount})`;
  submitAllBtn.disabled = savedCount === 0;
  if (!roots.length) {
    list.innerHTML = `<div class="sb-empty">No pins yet. Turn on Pin mode and click the page to add one.</div>`;
    return;
  }
  list.innerHTML = roots.map((r) => {
    const status = displayStatus(r.id);
    const count = threadFor(r.id).length;
    const num = nums.get(r.id) ?? "";
    const meta = status === "gone"
      ? `<span class="pi-gone">anchor gone</span>`
      : `${escapeHtml(nodeTitle(r.anchorNodeId || r.nodeId)).slice(0, 42)}${count > 1 ? ` · <b class="pi-count">${count} in thread</b>` : ""}`;
    return `
      <button class="pin-item ${status} ${activePin && activePin.id === r.id ? "active" : ""}" data-pin-id="${r.id}">
        <span class="pi-num ${status}">${num || "•"}</span>
        <span class="pi-body">
          <span class="pi-text">${escapeHtml(r.text).slice(0, 90)}</span>
          <span class="pi-meta">${meta}</span>
        </span>
      </button>`;
  }).join("");
  list.querySelectorAll(".pin-item").forEach((el) => {
    el.onclick = () => {
      const id = el.dataset.pinId;
      const r = RESOLVED.get(id);
      if (r && !r.gone && typeof r.y === "number") {
        window.scrollTo({ top: Math.max(0, r.y - 140), behavior: "smooth" });
      }
      openPinPanel(id);
    };
  });
}

function downloadJson() {
  const blob = new Blob([JSON.stringify({ comments: COMMENTS }, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "comments.json";
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 0);
}

// Pure: DOMRect-like list + scroll offsets → page-coord boxes (drops empty rects).
function toPageRects(clientRects, sx, sy) {
  return Array.from(clientRects || [])
    .filter((r) => r.width > 0 && r.height > 0)
    .map((r) => ({ x: r.left + sx, y: r.top + sy, w: r.width, h: r.height }));
}

// id -> { gone, x, y, rects?, region? }. Recomputed from the live DOM each render
// so pins track their anchor across reflow/reload instead of drifting on frozen px.
let RESOLVED = new Map();

// Anchor element's box in PAGE coordinates (client rect + scroll), or null if the
// element is missing or collapsed to zero size.
function anchorPageRect(nodeId) {
  if (!nodeId || nodeId === "freeform") return null;
  const el = document.querySelector(`[data-node-id="${CSS.escape(String(nodeId))}"]`);
  if (!el) return null;
  const r = el.getBoundingClientRect();
  if (r.width === 0 && r.height === 0) return null;
  return { left: r.left + window.scrollX, top: r.top + window.scrollY, width: r.width, height: r.height };
}

// Find an exact text run inside rootEl and return a Range, or null if absent.
function findTextRange(rootEl, needle) {
  if (!rootEl || !needle) return null;
  const walker = document.createTreeWalker(rootEl, NodeFilter.SHOW_TEXT);
  let full = "";
  const map = [];
  let n;
  while ((n = walker.nextNode())) { map.push({ node: n, start: full.length }); full += n.nodeValue; }
  const idx = full.indexOf(needle);
  if (idx < 0) return null;
  const end = idx + needle.length;
  const startEntry = [...map].reverse().find((m) => m.start <= idx);
  const endEntry = [...map].reverse().find((m) => m.start < end);
  if (!startEntry || !endEntry) return null;
  const range = document.createRange();
  range.setStart(startEntry.node, idx - startEntry.start);
  range.setEnd(endEntry.node, end - endEntry.start);
  return range;
}

// Resolve ONE comment to live geometry, or mark it gone (anchor/text no longer present).
function resolveOne(c) {
  const rect = anchorPageRect(c.anchorNodeId);

  if (c.kind === "region" && c.region) {
    if (!rect) return { gone: true };
    const x0 = rect.left + c.region.fx0 * rect.width, y0 = rect.top + c.region.fy0 * rect.height;
    const x1 = rect.left + c.region.fx1 * rect.width, y1 = rect.top + c.region.fy1 * rect.height;
    const box = { x: Math.min(x0, x1), y: Math.min(y0, y1), w: Math.abs(x1 - x0), h: Math.abs(y1 - y0) };
    return { gone: false, x: box.x, y: box.y, region: box };
  }

  if (c.kind === "area") {
    if (!rect) return { gone: true };
    const el = document.querySelector(`[data-node-id="${CSS.escape(String(c.anchorNodeId))}"]`);
    const range = findTextRange(el, c.contextSnippet || "");
    if (range) {
      const rects = toPageRects(range.getClientRects(), window.scrollX, window.scrollY);
      if (rects.length) return { gone: false, x: rects[0].x + rects[0].w, y: rects[0].y, rects };
    }
    // Anchor present but the quoted text is gone -> Done-and-Gone (the thing it pointed at was deleted).
    return { gone: true };
  }

  // POINT (and legacy pins). Prefer anchor-relative fraction; fall back to frozen x/y.
  if (rect && typeof c.fx === "number" && typeof c.fy === "number") {
    return { gone: false, x: rect.left + c.fx * rect.width, y: rect.top + c.fy * rect.height };
  }
  if (typeof c.x === "number" && typeof c.y === "number") {
    // A legacy pin that DID name an anchor which is now missing -> gone; otherwise keep frozen px.
    if (c.anchorNodeId && c.anchorNodeId !== "freeform" && !rect) return { gone: true };
    return { gone: false, x: c.x, y: c.y };
  }
  return { gone: true };
}

// Page point -> fraction (0..1) of the anchor element's box, clamped. null if no anchor.
function fractionInAnchor(anchorNodeId, pageX, pageY) {
  const rect = anchorPageRect(anchorNodeId);
  if (!rect) return null;
  const clamp = (v) => Math.max(0, Math.min(1, v));
  return { fx: clamp((pageX - rect.left) / rect.width), fy: clamp((pageY - rect.top) / rect.height) };
}

// Resolve every root pin once per render; replies inherit the root's placement.
function resolvePins() {
  RESOLVED = new Map();
  for (const c of COMMENTS) {
    if (c.parentId) continue;
    RESOLVED.set(c.id, resolveOne(c));
  }
}

function renderFloatingPins() {
  const overlay = document.getElementById("pin-overlay");
  overlay.style.height = document.documentElement.scrollHeight + "px";
  const nums = pinNumbers();

  // Highlights: area rects + region boxes, from resolved geometry.
  let highlights = "";
  for (const c of COMMENTS) {
    if (c.parentId) continue;
    const r = RESOLVED.get(c.id);
    if (!r || r.gone) continue;
    if (Array.isArray(r.rects)) {
      highlights += r.rects
        .map((rc) => `<div class="pin-hl ${c.status}" style="left:${rc.x}px; top:${rc.y}px; width:${rc.w}px; height:${rc.h}px;"></div>`)
        .join("");
    }
    if (r.region) {
      highlights += `<div class="pin-region ${c.status}" style="left:${r.region.x}px; top:${r.region.y}px; width:${r.region.w}px; height:${r.region.h}px;"></div>`;
    }
  }

  // Markers: one per placed root pin.
  const placed = COMMENTS.filter((c) => !c.parentId && RESOLVED.get(c.id) && !RESOLVED.get(c.id).gone);
  const markers = placed.map((c) => {
    const r = RESOLVED.get(c.id);
    return `
    <div class="floating-pin ${c.status} ${activePin && activePin.id === c.id ? "active" : ""}"
         data-pin-id="${c.id}" style="left:${r.x}px; top:${r.y}px;"
         title="${escapeHtml(c.text).slice(0, 80)}">
      <div class="marker">
        <svg viewBox="0 0 26 32"><path d="M13 1c6.6 0 12 5 12 11 0 8-12 19-12 19S1 20 1 12C1 6 6.4 1 13 1z"/></svg>
        <span>${nums.get(c.id) ?? ""}</span>
      </div>
      <button class="delete-btn" data-delete-id="${c.id}" title="Delete pin">×</button>
    </div>`;
  }).join("");

  overlay.innerHTML = highlights + markers;
  overlay.querySelectorAll(".floating-pin").forEach((el) => {
    el.onclick = (e) => {
      if (e.target.matches(".delete-btn")) { e.stopPropagation(); deleteComment(e.target.dataset.deleteId); return; }
      e.stopPropagation();
      openPinPanel(el.dataset.pinId);
    };
  });
}

async function deleteComment(id) {
  const res = await fetch("/comment/" + id, { method: "DELETE" });
  if (res.ok || res.status === 404) {
    if (activePin && activePin.id === id) closePanel();
    await load();
  }
}

function positionPanelNear(x, y) {
  const panel = document.getElementById("panel");
  panel.style.display = "flex";
  panel.classList.add("open");
  const rect = panel.getBoundingClientRect();
  const w = rect.width || 380;
  const h = rect.height || 320;
  const margin = 12;
  const offset = 20;
  let left = x + offset;
  if (left + w + margin > window.scrollX + window.innerWidth) left = x - w - offset;
  if (left < window.scrollX + margin) left = window.scrollX + margin;
  let top = y + offset;
  if (top + h + margin > window.scrollY + window.innerHeight) top = y - h - offset;
  if (top < window.scrollY + margin) top = window.scrollY + margin;
  panel.style.left = left + "px";
  panel.style.top = top + "px";
}

function openPinDraftPanel(p) {
  document.getElementById("comment-text").style.display = "";
  document.getElementById("comment-submit").textContent = "Submit to Claude";
  document.getElementById("comment-save").textContent = "Save pin";
  document.getElementById("comment-save").style.display = "";
  document.querySelector(".submit-row").style.display = "flex";
  document.getElementById("submit-draft").style.display = "none";
  activePin = null;
  pendingPin = p;
  const kindLabel = p.kind === "area" ? "New note on selection" : p.kind === "region" ? "New note on region" : "New pin";
  document.getElementById("panel-title").textContent = kindLabel;
  document.getElementById("panel-sub").textContent =
    (p.kind === "area" ? "selected text" : p.kind === "region" ? "selected region" : `at (${Math.round(p.x)}, ${Math.round(p.y)})`) +
    (p.anchorNodeId ? ` · ${p.anchorNodeId}` : "");
  document.getElementById("comment-text").value = "";
  document.getElementById("comments-list").innerHTML =
    `<div style="font-size:12px;color:var(--muted);padding:14px;text-align:center;">${
      p.contextSnippet ? "Context: <i>" + escapeHtml(p.contextSnippet).slice(0, 200) + "</i>" : "Drop your question."
    }</div>`;
  positionPanelNear(p.x, p.y);
  document.getElementById("comment-text").focus();
}

function threadFor(pinId) {
  return COMMENTS
    .filter((x) => x.id === pinId || x.parentId === pinId)
    .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); // newest first
}

// Refresh the open pin's thread in place (live), WITHOUT touching the textarea
// or repositioning — so a WebSocket update can't wipe what's being typed.
function refreshOpenThread() {
  if (!activePin) return;
  const thread = threadFor(activePin.id);
  if (!thread.length) { closePanel(); return; }
  document.getElementById("comments-list").innerHTML = thread.map(renderCommentHTML).join("");
  wireDeleteButtons();
}

function openPinPanel(pinId) {
  const root = COMMENTS.find((x) => x.id === pinId);
  if (!root) return;
  const isDraft = root.status === "saved";
  document.getElementById("comment-text").style.display = isDraft ? "none" : "";
  document.querySelector(".submit-row").style.display = isDraft ? "none" : "flex";
  document.getElementById("comment-save").style.display = isDraft ? "none" : "";
  document.getElementById("comment-save").textContent = "Save reply";
  document.getElementById("comment-submit").textContent = "Submit reply";
  document.getElementById("submit-draft").style.display = isDraft ? "block" : "none";
  activePin = { id: pinId, nodeId: root.nodeId, nodeLabel: root.nodeLabel, anchorNodeId: root.anchorNodeId ?? null };
  pendingPin = null;
  const thread = threadFor(pinId);
  document.getElementById("panel-title").textContent = root.anchorNodeId ? `Pin · ${root.anchorNodeId}` : "Pin";
  document.getElementById("panel-sub").innerHTML =
    escapeHtml(root.x != null ? `(${Math.round(root.x)}, ${Math.round(root.y)})` : (root.nodeLabel || "")) +
    (thread.length > 1 ? ` · <b>${thread.length} in thread</b>` : "");
  document.getElementById("comment-text").value = "";
  document.getElementById("comment-text").placeholder = "Reply or follow up on this pin…";
  document.getElementById("comments-list").innerHTML = thread.map(renderCommentHTML).join("");
  wireDeleteButtons();
  const r = RESOLVED.get(pinId);
  const x = (r && !r.gone && r.x != null) ? r.x : window.scrollX + window.innerWidth / 2;
  const y = (r && !r.gone && r.y != null) ? r.y : window.scrollY + window.innerHeight / 2;
  positionPanelNear(x, y);
  renderFloatingPins();
}

function renderCommentHTML(c) {
  return `
    <div class="comment">
      <div class="head">
        <span>${new Date(c.createdAt).toLocaleString()}</span>
        <div style="display:flex;align-items:center;gap:6px;">
          <span class="status ${c.status}">${c.status}</span>
          <button class="delete" data-delete-id="${c.id}" title="Delete">×</button>
        </div>
      </div>
      <div class="text">${escapeHtml(c.text)}</div>
      ${c.response ? `<div class="response">${renderMarkdown(c.response)}</div>` : ""}
    </div>`;
}

function wireDeleteButtons() {
  document.querySelectorAll("[data-delete-id]").forEach((b) => {
    b.onclick = () => deleteComment(b.dataset.deleteId);
  });
}

function escapeHtml(s) {
  return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
}

function closePanel() {
  const p = document.getElementById("panel");
  p.classList.remove("open");
  p.style.display = "none";
  activePin = null;
  pendingPin = null;
  renderFloatingPins();
}

document.getElementById("panel-close").onclick = closePanel;

async function postPin(deliver) {
  const text = document.getElementById("comment-text").value.trim();
  if (!text || !pendingPin) return;
  const submitBtn = document.getElementById("comment-submit");
  const saveBtn = document.getElementById("comment-save");
  submitBtn.disabled = true; saveBtn.disabled = true;
  try {
    const payload = {
      nodeId: pendingPin.anchorNodeId || "freeform",
      nodeLabel: pendingPin.label || pendingPin.anchorNodeId || "Freeform pin",
      text,
      submit: deliver,
      x: pendingPin.x,
      y: pendingPin.y,
      pageWidth: document.documentElement.scrollWidth,
      pageHeight: document.documentElement.scrollHeight,
      anchorNodeId: pendingPin.anchorNodeId,
      contextSnippet: pendingPin.contextSnippet,
      kind: pendingPin.kind || "point",
      ...(typeof pendingPin.fx === "number" && typeof pendingPin.fy === "number"
        ? { fx: pendingPin.fx, fy: pendingPin.fy }
        : {}),
      ...(pendingPin.rects ? { rects: pendingPin.rects } : {}),
      ...(pendingPin.region ? { region: pendingPin.region } : {}),
    };
    await fetch("/comment", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    });
    document.getElementById("comment-text").value = "";
    showToast(deliver ? "Pinned — sent to Claude." : "Pin saved as draft.");
    pendingPin = null;
    closePanel();
    await load();
  } finally { submitBtn.disabled = false; saveBtn.disabled = false; }
}

async function postReply(deliver) {
  const text = document.getElementById("comment-text").value.trim();
  if (!text || !activePin) return;
  const submitBtn = document.getElementById("comment-submit");
  const saveBtn = document.getElementById("comment-save");
  submitBtn.disabled = true; saveBtn.disabled = true;
  try {
    await fetch("/comment", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        nodeId: activePin.nodeId || "freeform",
        nodeLabel: activePin.nodeLabel || "Follow-up",
        text,
        submit: deliver,
        parentId: activePin.id,
        anchorNodeId: activePin.anchorNodeId,
      }),
    });
    document.getElementById("comment-text").value = "";
    showToast(deliver ? "Reply sent to Claude." : "Reply saved as draft.");
    const reopenId = activePin.id;
    await load();
    openPinPanel(reopenId);
  } finally { submitBtn.disabled = false; saveBtn.disabled = false; }
}

async function submitPins(ids) {
  await fetch("/submit", {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify(ids ? { ids } : {}),
  });
  showToast("Sent to Claude.");
  const reopenId = activePin ? activePin.id : null;
  await load();
  if (reopenId) openPinPanel(reopenId);
}

document.getElementById("comment-submit").onclick = () => {
  if (pendingPin) postPin(true);
  else if (activePin) postReply(true);
};
document.getElementById("comment-save").onclick = () => {
  if (pendingPin) postPin(false);
  else if (activePin) postReply(false);
};
document.getElementById("submit-draft").onclick = () => { if (activePin) submitPins([activePin.id]); };
document.getElementById("submit-all").onclick = () => submitPins();

const pinToggleBtn = document.getElementById("pin-toggle");
pinToggleBtn.onclick = () => {
  pinMode = !pinMode;
  document.body.classList.toggle("pin-mode", pinMode);
  pinToggleBtn.classList.toggle("on", pinMode);
  pinToggleBtn.textContent = "Pin mode: " + (pinMode ? "on" : "off");
};

document.getElementById("dl-json").onclick = downloadJson;

// Region pins: press-drag a rectangle. We record the start on mousedown and draw
// a rubber-band on mousemove; mouseup decides point vs area vs region.
let dragStart = null;
document.addEventListener("mousedown", (e) => {
  if (!pinMode) return;
  if (e.target.closest("#panel") || e.target.closest("#pin-sidebar") ||
      e.target.closest("#pin-toggle") || e.target.closest("#chat-dock") ||
      e.target.closest(".floating-pin")) return;
  dragStart = { x: e.pageX, y: e.pageY, anchor: e.target.closest("[data-node-id]") };
});
// Prevent native image/content drag in Pin mode so a region marquee that starts on
// an image (draggable by default) isn't hijacked by the browser's native DnD.
document.addEventListener("dragstart", (e) => { if (pinMode) e.preventDefault(); });
document.addEventListener("mousemove", (e) => {
  if (!pinMode || !dragStart) return;
  const rb = document.getElementById("rubber");
  if (!rb) return;
  // Suppress the region marquee while the user is selecting TEXT — that drag is an
  // area pin, not a region; a dashed box alongside a text selection is confusing.
  const sel = window.getSelection();
  if (sel && !sel.isCollapsed) { rb.style.display = "none"; return; }
  const x = Math.min(dragStart.x, e.pageX), y = Math.min(dragStart.y, e.pageY);
  const w = Math.abs(e.pageX - dragStart.x), h = Math.abs(e.pageY - dragStart.y);
  if (w < 4 && h < 4) { rb.style.display = "none"; return; }
  rb.style.display = "block";
  rb.style.left = x + "px"; rb.style.top = y + "px";
  rb.style.width = w + "px"; rb.style.height = h + "px";
});

// Pin mode: on mouseup, a non-empty text selection → AREA pin (exact quote +
// highlight boxes); a plain click → POINT pin. The selection is captured BEFORE
// opening the panel, because focusing the textarea collapses it.
document.addEventListener("mouseup", (e) => {
  const start = dragStart;
  dragStart = null;
  const rb = document.getElementById("rubber");
  if (rb) rb.style.display = "none";

  if (!pinMode) return;
  if (e.target.closest("#panel")) return;
  if (e.target.closest("#pin-sidebar")) return;
  if (e.target.closest("#pin-toggle")) return;
  if (e.target.closest("#chat-dock")) return;
  if (e.target.closest(".floating-pin")) return;

  const sel = window.getSelection();
  const selText = sel && !sel.isCollapsed ? sel.toString().trim() : "";

  if (selText && sel.rangeCount) {
    // AREA pin — capture geometry + anchor + exact text now, before the panel steals focus.
    const range = sel.getRangeAt(0);
    const rects = toPageRects(range.getClientRects(), window.scrollX, window.scrollY);
    let node = range.commonAncestorContainer;
    if (node && node.nodeType === 3) node = node.parentElement;
    const anchorEl = node && node.closest ? node.closest("[data-node-id]") : null;
    const bb = range.getBoundingClientRect();
    openPinDraftPanel({
      kind: "area",
      x: bb.right + window.scrollX,
      y: bb.top + window.scrollY,
      rects,
      anchorNodeId: anchorEl ? anchorEl.dataset.nodeId : null,
      contextSnippet: selText.slice(0, 1000),
      label: selText.slice(0, 60),
    });
    return;
  }

  // REGION pin — dragged a box but selected no text (e.g. on an image/card).
  if (start) {
    const dx = e.pageX - start.x, dy = e.pageY - start.y;
    if (Math.hypot(dx, dy) > 6) {
      const anchorEl = start.anchor;
      const rect = anchorEl ? anchorPageRect(anchorEl.dataset.nodeId) : null;
      const x0p = Math.min(start.x, e.pageX), y0p = Math.min(start.y, e.pageY);
      const x1p = Math.max(start.x, e.pageX), y1p = Math.max(start.y, e.pageY);
      let region = null;
      if (rect) {
        const cl = (v) => Math.max(0, Math.min(1, v));
        region = {
          fx0: cl((x0p - rect.left) / rect.width), fy0: cl((y0p - rect.top) / rect.height),
          fx1: cl((x1p - rect.left) / rect.width), fy1: cl((y1p - rect.top) / rect.height),
        };
      }
      openPinDraftPanel({
        kind: "region",
        x: x0p, y: y0p,
        anchorNodeId: anchorEl ? anchorEl.dataset.nodeId : null,
        contextSnippet: anchorEl ? `region of ${anchorEl.dataset.nodeId}` : "freeform region",
        label: anchorEl ? `region · ${anchorEl.dataset.nodeId}` : "region",
        ...(region ? { region } : {}),
      });
      return;
    }
  }

  // POINT pin — plain click on an element or whitespace.
  const anchor = e.target.closest("[data-node-id]");
  const anchorId = anchor ? anchor.dataset.nodeId : null;
  const nearText = (e.target.textContent ?? "").trim().replace(/\s+/g, " ").slice(0, 200);
  const frac = anchorId ? fractionInAnchor(anchorId, e.pageX, e.pageY) : null;
  openPinDraftPanel({
    kind: "point",
    x: e.pageX,
    y: e.pageY,
    anchorNodeId: anchorId,
    contextSnippet: nearText,
    label: anchor ? anchor.textContent.trim().slice(0, 60) : null,
    ...(frac || {}),
  });
});

// Esc closes panel / exits pin mode
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") {
    if (document.getElementById("panel").classList.contains("open")) closePanel();
    else if (pinMode) pinToggleBtn.click();
  }
});

function showToast(msg) {
  const t = document.getElementById("toast");
  t.textContent = msg || "Comment pinned.";
  t.classList.add("show");
  setTimeout(() => t.classList.remove("show"), 2400);
}

// ---- Chat panel: a node-less conversation surface. The user types here (POST
// /chat → channel event with chat_id="chat", no node_id); Claude posts back via
// the post_message tool (→ chat.json → "chat-updated" broadcast). It exists so
// Claude can reach the user proactively instead of narrating to a terminal the
// user isn't looking at.
async function loadChat() {
  try {
    const r = await fetch("/chat.json", { cache: "no-store" });
    const j = await r.json();
    CHAT = Array.isArray(j.messages) ? j.messages : [];
  } catch { CHAT = []; }
  renderChat();
}

function claudeCount() { return CHAT.filter((m) => m.role === "claude").length; }

function renderChat() {
  const box = document.getElementById("chat-messages");
  if (!CHAT.length) {
    box.innerHTML = `<div class="chat-empty">No messages yet. Claude posts here when it needs to reach you — a question, a heads-up, a confirmation. Message back any time.</div>`;
  } else {
    box.innerHTML = CHAT.map((m) =>
      `<div class="chat-msg ${m.role === "claude" ? "claude" : "user"}">${
        m.role === "claude" ? renderMarkdown(m.text) : escapeHtml(m.text)
      }</div>`
    ).join("");
    box.scrollTop = box.scrollHeight;
  }
  updateChatUnread();
}

function updateChatUnread() {
  const badge = document.getElementById("chat-unread");
  if (chatOpen) { chatSeen = claudeCount(); badge.classList.remove("show"); badge.textContent = "0"; return; }
  const unread = Math.max(0, claudeCount() - chatSeen);
  if (unread > 0) { badge.textContent = String(unread); badge.classList.add("show"); }
  else badge.classList.remove("show");
}

function setChatOpen(open) {
  chatOpen = open;
  document.getElementById("chat-dock").classList.toggle("open", open);
  document.getElementById("chat-toggle").textContent = open ? "▾" : "▴";
  if (open) {
    chatSeen = claudeCount();
    updateChatUnread();
    const box = document.getElementById("chat-messages");
    box.scrollTop = box.scrollHeight;
    document.getElementById("chat-input").focus();
  }
}

// Claude posted while we weren't looking → bump + auto-open so it can't be missed
// (the whole reason the chat exists). A user's own message never auto-opens.
function onChatPushed() {
  const before = chatSeen;
  loadChat().then(() => {
    if (!chatOpen && claudeCount() > before) {
      const dock = document.getElementById("chat-dock");
      dock.classList.add("bump");
      setTimeout(() => dock.classList.remove("bump"), 400);
      setChatOpen(true);
    }
  });
}

async function sendChat() {
  const ta = document.getElementById("chat-input");
  const text = ta.value.trim();
  if (!text) return;
  const btn = document.getElementById("chat-send");
  btn.disabled = true;
  try {
    await fetch("/chat", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ text }),
    });
    ta.value = "";
    await loadChat();
  } finally { btn.disabled = false; }
}

document.getElementById("chat-head").onclick = () => setChatOpen(!chatOpen);
document.getElementById("chat-send").onclick = sendChat;
document.getElementById("chat-input").addEventListener("keydown", (e) => {
  if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendChat(); }
});

// Live updates over WebSocket (with reconnect) + polling safety net
function connectWs() {
  try {
    const ws = new WebSocket("ws://" + location.host + "/ws");
    ws.onmessage = (e) => {
      try {
        const m = JSON.parse(e.data);
        if (m.type === "server-stopping") { showStoppedBanner(); return; }
        if (m.type === "data-updated" || m.type === "comments-updated") load();
        if (m.type === "chat-updated") onChatPushed();
      } catch {}
    };
    ws.onclose = () => setTimeout(connectWs, 2000);
  } catch {
    setTimeout(connectWs, 2000);
  }
}

function showStoppedBanner() {
  document.body.innerHTML =
    '<div style="max-width:560px;margin:18vh auto;text-align:center;font:16px system-ui;color:var(--text)">' +
    '<h2>Server stopped</h2>' +
    '<p>The channel is closed and the port is freed. Safe to close this tab.</p></div>';
}
document.getElementById("shutdown-btn").addEventListener("click", async () => {
  if (!confirm("Stop the server and close the channel? The artifact will go offline.")) return;
  try {
    await fetch("/shutdown", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: "{}",
    });
  } catch {}
  showStoppedBanner();
});

load();
loadChat();
setInterval(() => { load(); loadChat(); }, 30_000);
connectWs();
let _resizeT = null;
window.addEventListener("resize", () => {
  clearTimeout(_resizeT);
  _resizeT = setTimeout(render, 120);
});
</script>
<div id="rubber"></div>
</body>
</html>
