#!/usr/bin/env bun
/**
 * __PLUGIN_NAME__ channel plugin for Claude Code.
 *
 * - Serves an interactive HTML artifact at http://localhost:__PORT__.
 * - When a user pins a comment in the UI, it is forwarded to the Claude Code
 *   session as a `notifications/claude/channel` event.
 * - Claude addresses the comment and calls the `mark_addressed` /
 *   `update_node` / `update_data` tools to update the artifact in place.
 *   The UI live-refreshes via WebSocket.
 * - Refuses requests that come from other websites open in the same browser
 *   (Host, Origin and Content-Type checks; see refuseForeign below).
 */

import { Server } from "@modelcontextprotocol/sdk/server/index.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import {
  ListToolsRequestSchema,
  CallToolRequestSchema,
} from "@modelcontextprotocol/sdk/types.js";
import { readFile, writeFile } from "node:fs/promises";
import { unlinkSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { randomUUID } from "node:crypto";
import type { ServerWebSocket } from "bun";

const DIR = import.meta.dir;
const PORT = Number(process.env.__PLUGIN_NAME_UPPER___PORT ?? __PORT__);
const COMMENTS_PATH = join(DIR, "comments.json");
const CHAT_PATH = join(DIR, "chat.json");
const DATA_PATH = join(DIR, "data.json");
const HTML_PATH = join(DIR, "index.html");
const RUNTIME_PATH = join(DIR, ".runtime.json");

// --- Request guard ---
// The server listens on 127.0.0.1 only, but a page from any other website open in
// the same browser can still send requests to it. Without these checks such a page
// could post a comment (which is forwarded into the live Claude session), delete
// comments, or stop the server. Every request passes refuseForeign() first.
const ALLOWED_HOSTS = new Set([`localhost:${PORT}`, `127.0.0.1:${PORT}`]);
const ALLOWED_ORIGINS = new Set([`http://localhost:${PORT}`, `http://127.0.0.1:${PORT}`]);

function refusal(status: number, error: string): Response {
  return new Response(JSON.stringify({ error }), {
    status,
    headers: { "content-type": "application/json" },
  });
}

// Returns the Response to send when the request must be refused, or null to proceed.
function refuseForeign(req: Request): Response | null {
  // 1. Host, on EVERY request (reads too). DNS-rebinding guard: a site that points
  //    its own name at 127.0.0.1 reaches this port with its own name in Host.
  const host = (req.headers.get("host") ?? "").toLowerCase();
  if (!ALLOWED_HOSTS.has(host)) return refusal(403, "host not allowed");

  // 2. Origin, on anything that is not a plain read, and on the WebSocket upgrade.
  //    Browsers send Origin on cross-site POST/DELETE and on every WebSocket
  //    handshake. No Origin means a non-browser client on this machine (curl, the
  //    tests), which is allowed.
  const isUpgrade = (req.headers.get("upgrade") ?? "").toLowerCase() === "websocket";
  const changesState = req.method !== "GET" && req.method !== "HEAD";
  const origin = req.headers.get("origin");
  if ((changesState || isUpgrade) && origin !== null && !ALLOWED_ORIGINS.has(origin.toLowerCase())) {
    return refusal(403, "origin not allowed");
  }

  // 3. Content-Type on every POST. A cross-site HTML form, or a cross-site fetch
  //    that skips the CORS preflight, can only send form or text/plain bodies.
  if (req.method === "POST") {
    const type = (req.headers.get("content-type") ?? "").split(";")[0].trim().toLowerCase();
    if (type !== "application/json") return refusal(415, "content-type must be application/json");
  }
  return null;
}

type Comment = {
  id: string;
  nodeId: string;
  nodeLabel: string;
  text: string;
  createdAt: string;
  status: "saved" | "pending" | "addressed";
  response: string | null;
  addressedAt: string | null;
  // Optional positional fields (set when dropped via Pin Mode)
  x?: number;
  y?: number;
  pageWidth?: number;
  pageHeight?: number;
  anchorNodeId?: string | null;
  contextSnippet?: string | null;
  // Set when this comment is a follow-up reply on an existing pin (thread).
  parentId?: string | null;
  // "point" (single click), "area" (text selection), or "region" (drag rectangle).
  kind?: "point" | "area" | "region";
  rects?: Array<{ x: number; y: number; w: number; h: number }>;
  // Anchor-relative position (fraction 0..1 of anchorNodeId's box). Lets pins
  // survive reflow/reload instead of drifting on frozen absolute x/y.
  fx?: number; fy?: number;                 // point pins
  region?: { fx0: number; fy0: number; fx1: number; fy1: number }; // region pins
};

type ChatMessage = {
  id: string;
  role: "claude" | "user";
  text: string;
  createdAt: string;
};

const clients = new Set<ServerWebSocket<unknown>>();

function broadcast(event: string, payload: unknown = {}) {
  const data = JSON.stringify({ type: event, ...(payload as object) });
  for (const ws of clients) if (ws.readyState === 1) ws.send(data);
}

async function readJson<T>(p: string): Promise<T> {
  return JSON.parse(await readFile(p, "utf8")) as T;
}

async function writeComments(file: { comments: Comment[] }) {
  await writeFile(COMMENTS_PATH, JSON.stringify(file, null, 2));
  broadcast("comments-updated");
}

async function writeData(data: unknown) {
  await writeFile(DATA_PATH, JSON.stringify(data, null, 2));
  broadcast("data-updated");
}

async function readChat(): Promise<{ messages: ChatMessage[] }> {
  try {
    return await readJson<{ messages: ChatMessage[] }>(CHAT_PATH);
  } catch {
    return { messages: [] };
  }
}

async function writeChat(file: { messages: ChatMessage[] }) {
  await writeFile(CHAT_PATH, JSON.stringify(file, null, 2));
  broadcast("chat-updated");
}

// --- MCP server (stdio) ---
const mcp = new Server(
  { name: "__PLUGIN_NAME__", version: "0.1.0" },
  {
    capabilities: { tools: {}, experimental: { "claude/channel": {} } },
    instructions: `Pinned comments from the __PLUGIN_NAME__ artifact arrive as <channel source="__PLUGIN_NAME__" chat_id="artifact" message_id="..."> events. The meta object has comment_id, node_id, node_label, and (for freeform/area pins) pin_x/pin_y/anchor_node_id/context_snippet/comment_type. Pins have comment_type point | area | region. An "area" pin carries the exact quoted text in context_snippet (the reviewer selected text). A "region" pin boxes part of an element (e.g. an image or a card) — meta carries anchor_node_id plus region_box, four comma-separated fractions fx0,fy0,fx1,fy1 of that element's box (top-left to bottom-right).

node_id maps to an entry in data.json — an object with a matching "id" somewhere in the data. For freeform pins (node_id="freeform"), use anchor_node_id + context_snippet for context.

<<CUSTOMISE: describe THIS artifact's domain here — what the data represents, what each node means, and any voice/style rules replies must follow.>>

When a comment arrives:
1. If it asks to CHANGE the artifact, edit data.json with update_node(node_id, { patch }) — the patch's keys are merged into the matched node. Use update_data only to replace the whole document (rare).
2. Then call mark_addressed(comment_id, response) with a SHORT (≤3 sentences) plain-text reply shown under the pin. If you changed the data, state the change as "before → after" in one line so nothing is silently overwritten.
3. If it only asks a QUESTION, answer in mark_addressed — short and plain. Use update_node only when the data should actually change.

If the channel meta has parent_id, this is a FOLLOW-UP on an earlier pinned comment — read comments.json for the thread (the comment whose id === parent_id, plus any earlier replies sharing that parent_id) and continue it, making further edits if asked.

If the channel meta has comment_type="area", the context_snippet is the EXACT text the user selected on the page — treat it as a precise quote and act on that specific wording. comment_type="point" is a single-point pin (context_snippet is just nearby text, less precise).

Messages that arrive with chat_id="chat" and NO node_id are general chat from the artifact's chat panel — not a pin. Reply with post_message(text), never mark_addressed (there is no comment to mark). Use post_message proactively as well: when you need to reach the user but have no pin to reply under — a clarifying question, a tradeoff worth flagging, a confirmation before a big change, a heads-up that something will take a while — post it to the chat. The user is watching the artifact, not the terminal, so anything you write only to the terminal is missed. (This is about substantive messages to the user, not process narration — the "don't narrate your process" rule still holds for pin replies.) You may call post_message unprompted at any time.

Do NOT narrate your process. Never describe which tools you called, what you investigated, or that this arrived over a channel. The reply is only what the user reads under their pinned note.

The artifact is at http://localhost:${PORT}. Comments persist in comments.json.`,
  },
);

mcp.setRequestHandler(ListToolsRequestSchema, async () => ({
  tools: [
    {
      name: "mark_addressed",
      description: "Mark a pinned comment as addressed with a response shown beneath it in the UI. Use this once you've answered the user's question.",
      inputSchema: {
        type: "object",
        properties: {
          comment_id: { type: "string", description: "The id from the channel meta" },
          response: { type: "string", description: "Short plain reply (≤3 sentences) shown under the pin. No process narration." },
        },
        required: ["comment_id", "response"],
      },
    },
    {
      name: "update_node",
      description: "Patch a single node in data.json. node_id matches an object with that id anywhere in the data (searched across array properties). The patch object's keys are merged into that node — e.g. { label: \"...\" } or { count: 42 }.",
      inputSchema: {
        type: "object",
        properties: {
          node_id: { type: "string" },
          patch: { type: "object", description: "Object whose keys overwrite the node's keys." },
        },
        required: ["node_id", "patch"],
      },
    },
    {
      name: "update_data",
      description: "Replace the entire data.json. Use sparingly — only for full refreshes.",
      inputSchema: {
        type: "object",
        properties: {
          data: { type: "object" },
        },
        required: ["data"],
      },
    },
    {
      name: "post_message",
      description: "Post a chat message to the artifact's chat panel, shown to the user immediately. Use this to proactively reach the user — a clarifying question, a tradeoff, a confirmation before a big change, a heads-up — when there is no specific pin to reply under. Prefer this over narrating to the terminal during a channel session: the user is watching the artifact, not the terminal.",
      inputSchema: {
        type: "object",
        properties: {
          text: { type: "string", description: "Markdown message shown in the chat panel." },
        },
        required: ["text"],
      },
    },
  ],
}));

mcp.setRequestHandler(CallToolRequestSchema, async (req) => {
  const args = (req.params.arguments ?? {}) as Record<string, unknown>;
  try {
    switch (req.params.name) {
      case "mark_addressed": {
        const id = String(args.comment_id);
        const response = String(args.response);
        const file = await readJson<{ comments: Comment[] }>(COMMENTS_PATH);
        const c = file.comments.find((x) => x.id === id);
        if (!c) throw new Error(`comment not found: ${id}`);
        c.status = "addressed";
        c.response = response;
        c.addressedAt = new Date().toISOString();
        await writeComments(file);
        return { content: [{ type: "text", text: `marked addressed: ${id}` }] };
      }
      case "update_node": {
        const nodeId = String(args.node_id);
        const patch = (args.patch ?? {}) as Record<string, unknown>;
        const data = await readJson<any>(DATA_PATH);
        // Generic lookup: search every array property of data for an object whose
        // id === nodeId, descending into nested arrays. First match wins.
        // Customise this if your data shape needs a more specific match.
        function findById(obj: any): any {
          if (!obj || typeof obj !== "object") return null;
          for (const v of Object.values(obj)) {
            if (!Array.isArray(v)) continue;
            for (const item of v) {
              if (item && typeof item === "object") {
                if (item.id === nodeId) return item;
                const nested = findById(item);
                if (nested) return nested;
              }
            }
          }
          return null;
        }
        const target = findById(data);
        if (!target) throw new Error(`node not found: ${nodeId}`);
        Object.assign(target, patch);
        await writeData(data);
        return { content: [{ type: "text", text: `patched ${nodeId}` }] };
      }
      case "update_data": {
        const data = args.data as Record<string, unknown>;
        if (!data || typeof data !== "object") throw new Error("data must be an object");
        await writeData(data);
        return { content: [{ type: "text", text: "data.json replaced" }] };
      }
      case "post_message": {
        const text = String(args.text ?? "").trim();
        if (!text) throw new Error("text required");
        const file = await readChat();
        const msg: ChatMessage = {
          id: randomUUID(),
          role: "claude",
          text,
          createdAt: new Date().toISOString(),
        };
        file.messages.push(msg);
        await writeChat(file);
        return { content: [{ type: "text", text: "posted chat message" }] };
      }
      default:
        return {
          content: [{ type: "text", text: `unknown tool: ${req.params.name}` }],
          isError: true,
        };
    }
  } catch (err) {
    return {
      content: [{ type: "text", text: `${req.params.name}: ${err instanceof Error ? err.message : err}` }],
      isError: true,
    };
  }
});

await mcp.connect(new StdioServerTransport());

function deliverChannel(comment: Comment) {
  const positional = typeof comment.x === "number" && typeof comment.y === "number";
  // CRITICAL: channel meta MUST be Record<string, string>. Numbers / nulls
  // throw Zod validation in Claude's stdio handler and silently kill the
  // transport after the first notification. Always String() and drop nullish.
  void mcp.notification({
    method: "notifications/claude/channel",
    params: {
      content: comment.text,
      meta: {
        chat_id: "artifact",
        message_id: comment.id,
        comment_id: comment.id,
        node_id: comment.nodeId,
        node_label: comment.nodeLabel,
        ts: comment.createdAt,
        ...(comment.parentId ? { parent_id: comment.parentId } : {}),
        ...(comment.kind ? { comment_type: comment.kind } : {}),
        ...(positional
          ? {
              pin_x: String(comment.x),
              pin_y: String(comment.y),
              page_width: String(comment.pageWidth ?? ""),
              page_height: String(comment.pageHeight ?? ""),
              ...(comment.anchorNodeId ? { anchor_node_id: comment.anchorNodeId } : {}),
              ...(comment.contextSnippet ? { context_snippet: comment.contextSnippet } : {}),
              ...(comment.kind === "region" && comment.region
                ? {
                    region_box: [
                      comment.region.fx0, comment.region.fy0,
                      comment.region.fx1, comment.region.fy1,
                    ].map((n) => n.toFixed(4)).join(","),
                  }
                : {}),
            }
          : {}),
      },
    },
  });
}

function deliverChat(msg: ChatMessage) {
  // Node-less channel event: chat_id="chat", no node_id — the instructions route
  // this to a post_message reply, not mark_addressed. Meta is all-strings (the
  // silent-transport killer): never put numbers/nulls/booleans in channel meta.
  void mcp.notification({
    method: "notifications/claude/channel",
    params: {
      content: msg.text,
      meta: {
        chat_id: "chat",
        message_id: msg.id,
        role: msg.role,
        ts: msg.createdAt,
      },
    },
  });
}

// --- HTTP / WebSocket UI ---
// If another instance already owns the port, run stdio-only — tool calls still
// land in the shared comments.json / data.json on disk. Without this, multiple
// Claude sessions launching the same plugin would each crash on EADDRINUSE
// and tear down the MCP transport.
let httpServer: ReturnType<typeof Bun.serve> | null = null;

// --- Teardown: one idempotent shutdown reachable from every trigger. ---
// Only the instance that bound the port (ownsRuntime) deletes the pidfile, so
// a stdio-only sibling tearing down never removes the live owner's file.
let ownsRuntime = false;
let shuttingDown = false;
function shutdown(reason: string): void {
  if (shuttingDown) return;
  shuttingDown = true;
  process.stderr.write(`__PLUGIN_NAME__: shutting down (${reason})\n`);
  try { broadcast("server-stopping", { reason }); } catch {}
  try { httpServer?.stop(true); } catch {}
  if (ownsRuntime) { try { unlinkSync(RUNTIME_PATH); } catch {} }
  process.exit(0);
}
process.on("SIGINT", () => shutdown("SIGINT"));
process.on("SIGTERM", () => shutdown("SIGTERM"));
// Claude closes this subprocess's stdin when the session ends. The MCP stdio
// transport already put stdin in flowing mode, so "end"/"close" fire on the
// real pipe close. (A FIFO does NOT reproduce this — verified. No resume() here:
// the transport owns the data; resuming ourselves would discard it.)
process.stdin.on("end", () => shutdown("session-end"));
process.stdin.on("close", () => shutdown("session-end"));

// If a previous run left .runtime.json but its pid is dead, reclaim it. A live
// pid is left alone (it's a real sibling) — preserves the multi-session path.
function reclaimStaleRuntime(): void {
  if (!existsSync(RUNTIME_PATH)) return;
  try {
    const prev = JSON.parse(readFileSync(RUNTIME_PATH, "utf8"));
    if (typeof prev?.pid === "number") {
      try { process.kill(prev.pid, 0); return; } catch { unlinkSync(RUNTIME_PATH); }
    } else {
      unlinkSync(RUNTIME_PATH);
    }
  } catch { try { unlinkSync(RUNTIME_PATH); } catch {} }
}
reclaimStaleRuntime();

// A re-created worktree or fresh scaffold may not ship chat.json — create it so
// the chat panel's /chat.json fetch and post_message both work from first boot.
if (!existsSync(CHAT_PATH)) {
  try { writeFileSync(CHAT_PATH, JSON.stringify({ messages: [] }, null, 2)); } catch {}
}

try {
  httpServer = Bun.serve({
    port: PORT,
    hostname: "127.0.0.1",
    async fetch(req, server) {
      const refused = refuseForeign(req);
      if (refused) return refused;
      const url = new URL(req.url);

      if (url.pathname === "/ws") {
        if (server.upgrade(req)) return;
        return new Response("upgrade failed", { status: 400 });
      }

      if (url.pathname === "/" || url.pathname === "/index.html") {
        return new Response(await readFile(HTML_PATH), {
          headers: { "content-type": "text/html; charset=utf-8" },
        });
      }

      if (url.pathname === "/data.json") {
        return new Response(await readFile(DATA_PATH), {
          headers: { "content-type": "application/json", "cache-control": "no-store" },
        });
      }

      if (url.pathname === "/comments.json") {
        return new Response(await readFile(COMMENTS_PATH), {
          headers: { "content-type": "application/json", "cache-control": "no-store" },
        });
      }

      if (url.pathname === "/chat.json") {
        return new Response(await readFile(CHAT_PATH), {
          headers: { "content-type": "application/json", "cache-control": "no-store" },
        });
      }

      if (url.pathname === "/comment" && req.method === "POST") {
        const body = (await req.json()) as Partial<Comment> & { text: string; submit?: boolean };
        if (!body?.nodeId || !body?.text?.trim()) {
          return new Response(JSON.stringify({ error: "nodeId and text required" }), {
            status: 400,
            headers: { "content-type": "application/json" },
          });
        }
        // submit defaults to true (deliver now). { submit: false } saves a DRAFT
        // pin — persisted but NOT delivered until POST /submit flips it to pending.
        const submit = body.submit !== false;
        const file = await readJson<{ comments: Comment[] }>(COMMENTS_PATH);
        const entry: Comment = {
          id: randomUUID(),
          nodeId: body.nodeId,
          nodeLabel: body.nodeLabel ?? body.nodeId,
          text: body.text.trim(),
          createdAt: new Date().toISOString(),
          status: submit ? "pending" : "saved",
          response: null,
          addressedAt: null,
          parentId: body.parentId ?? null,
          ...(typeof body.x === "number" && typeof body.y === "number"
            ? {
                x: body.x,
                y: body.y,
                pageWidth: body.pageWidth,
                pageHeight: body.pageHeight,
                anchorNodeId: body.anchorNodeId ?? null,
                contextSnippet: body.contextSnippet ?? null,
                kind:
                  body.kind === "area" ? "area" : body.kind === "region" ? "region" : "point",
                ...(Array.isArray(body.rects) ? { rects: body.rects } : {}),
                ...(typeof body.fx === "number" && typeof body.fy === "number"
                  ? { fx: body.fx, fy: body.fy }
                  : {}),
                ...(body.region && typeof body.region.fx0 === "number"
                  ? { region: body.region }
                  : {}),
              }
            : {}),
        };
        file.comments.push(entry);
        await writeComments(file);
        if (submit) deliverChannel(entry);
        return new Response(JSON.stringify(entry), {
          headers: { "content-type": "application/json" },
        });
      }

      if (url.pathname === "/submit" && req.method === "POST") {
        // No ids → submit every saved (draft) comment (the "Submit all" button).
        // ids → submit just those (individual submit from an open saved pin).
        const body = (await req.json().catch(() => ({}))) as { ids?: string[] };
        const file = await readJson<{ comments: Comment[] }>(COMMENTS_PATH);
        const targets = file.comments.filter(
          (c) => c.status === "saved" && (!Array.isArray(body.ids) || body.ids.includes(c.id)),
        );
        for (const c of targets) c.status = "pending";
        await writeComments(file);
        for (const c of targets) deliverChannel(c);
        return new Response(JSON.stringify({ submitted: targets.map((c) => c.id) }), {
          headers: { "content-type": "application/json" },
        });
      }

      if (url.pathname === "/chat" && req.method === "POST") {
        const body = (await req.json()) as { text?: string };
        if (!body?.text?.trim()) {
          return new Response(JSON.stringify({ error: "text required" }), {
            status: 400,
            headers: { "content-type": "application/json" },
          });
        }
        const file = await readChat();
        const msg: ChatMessage = {
          id: randomUUID(),
          role: "user",
          text: body.text.trim(),
          createdAt: new Date().toISOString(),
        };
        file.messages.push(msg);
        await writeChat(file);
        deliverChat(msg);
        return new Response(JSON.stringify(msg), {
          headers: { "content-type": "application/json" },
        });
      }

      if (url.pathname.startsWith("/comment/") && req.method === "DELETE") {
        const id = url.pathname.slice("/comment/".length);
        const file = await readJson<{ comments: Comment[] }>(COMMENTS_PATH);
        const before = file.comments.length;
        file.comments = file.comments.filter((c) => c.id !== id);
        if (file.comments.length === before) {
          return new Response(JSON.stringify({ error: "not found" }), {
            status: 404,
            headers: { "content-type": "application/json" },
          });
        }
        // CRITICAL: do NOT call deliverChannel on delete. Only adds notify
        // Claude — otherwise it wastes turns answering removed comments.
        await writeComments(file);
        return new Response(null, { status: 204 });
      }

      if (url.pathname === "/shutdown" && req.method === "POST") {
        // Respond first; tear down shortly after so the response flushes.
        setTimeout(() => shutdown("ui"), 100);
        return new Response(JSON.stringify({ stopping: true }), {
          headers: { "content-type": "application/json" },
        });
      }

      return new Response("not found", { status: 404 });
    },
    websocket: {
      open: (ws) => { clients.add(ws); },
      close: (ws) => { clients.delete(ws); },
      message: () => {},
    },
  });
  ownsRuntime = true;
  writeFileSync(
    RUNTIME_PATH,
    JSON.stringify({ pid: process.pid, port: PORT, startedAt: new Date().toISOString() }, null, 2),
  );
  process.stderr.write(`__PLUGIN_NAME__: http://localhost:${PORT}\n`);
} catch (err) {
  const msg = err instanceof Error ? err.message : String(err);
  if (/EADDRINUSE|in use|address already/i.test(msg)) {
    process.stderr.write(
      `__PLUGIN_NAME__: port ${PORT} already in use — running stdio-only. ` +
      `Tool calls still update the shared state files. ` +
      `If this is a leftover/orphan, free it with: bash stop.sh --port ${PORT}\n`
    );
    // Without Bun.serve holding the event loop open, the script would exit
    // after this catch and Claude would see "Connection closed". Pin stdin
    // open so MCP requests can keep flowing.
    process.stdin.resume();
  } else {
    throw err;
  }
}
